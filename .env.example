# ==============================================================================
# Saasify AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local for local development customizations.

# Vite Development Server Port
VITE_PORT=5173

# Application Root URL (default: relative './' for static CDN / GitHub Pages / Vercel)
VITE_APP_BASE_URL=./

# Mock AI Engine (true enables client-side MockAI token streaming simulation)
VITE_ENABLE_MOCK_AI=true

# Optional External AI API Endpoints (e.g. OpenAI, Anthropic, Custom LLM Gateway)
# VITE_AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=your_api_key_here

# Telemetry & Analytics (Optional)
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X

